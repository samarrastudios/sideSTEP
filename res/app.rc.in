// Icon + version details for a sideSTEP binary. Configured once per target by CMake.
#include <winver.h>

IDI_APP ICON "@CMAKE_SOURCE_DIR@/assets/brand/icon/sidestep.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @RC_VERSION_COMMAS@,0
PRODUCTVERSION @RC_VERSION_COMMAS@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE @RC_FILETYPE@
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Adrian Samarra"
            VALUE "FileDescription", "@RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@RC_FILENAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Adrian Samarra. MIT License."
            VALUE "OriginalFilename", "@RC_FILENAME@"
            VALUE "ProductName", "@APP_DISPLAY_NAME@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "Open source, for Windows. https://github.com/samarrastudios/sideSTEP"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
